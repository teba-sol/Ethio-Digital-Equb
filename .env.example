# Sahil — Ekub Ledger environment variables

# PostgreSQL connection string (for server-side sync backup)
# Get one free from https://neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Shared secret for sync authentication
# Generate one: openssl rand -hex 32
# Paste the same value into the app's Settings > Sync Key
EKUB_SYNC_SECRET=""
